{
  "outputDirectory": "public",
  "functions": {
    "api/app.js": { "includeFiles": "{admin-pages,handlers}/**" }
  },
  "redirects": [
    { "source": "/tracker.html", "destination": "/admin/tracker", "permanent": false },
    { "source": "/conversations.html", "destination": "/admin/conversations", "permanent": false },
    { "source": "/admin", "destination": "/admin/reservations", "permanent": false }
  ],
  "rewrites": [
    { "source": "/admin/login", "destination": "/admin/login.html" },
    { "source": "/admin/:page(tracker|conversations|reservations)", "destination": "/api/app?__route=admin-page&page=:page" },
    { "source": "/api/:route(tracker|conversations|admin|reservations|web-chat)", "destination": "/api/app?__route=:route" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
